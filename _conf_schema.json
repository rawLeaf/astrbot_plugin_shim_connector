{
  "shims": {
    "description": "🔌 总开关",
    "type": "object",
    "hint": "总闸。开启 = 按各自的分开关走；关闭 = 全部不启动。",
    "items": {
      "enabled": {
        "description": "全部开启",
        "type": "bool",
        "default": true,
        "hint": "全部 shim 的总开关。关掉后所有 shim 都不启动。",
        "obvious_hint": true
      },
      "custom": {
        "description": "自定义 shim",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [],
        "hint": "自定义 shim 定义。一般不用动。"
      }
    }
  },
  "workbuddy": {
    "description": "WorkBuddy 接入",
    "type": "object",
    "hint": "需本机安装并登录 WorkBuddy 桌面端。凭据自动读取解密，无需配置。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "本 shim 开关。最终启用 = 总闸 AND 这一项。",
        "obvious_hint": true
      },
      "models": {
        "description": "要注册的模型",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [],
        "hint": "要注册给 AstrBot 的模型名。"
      },
      "port": {
        "description": "端口",
        "type": "int",
        "default": 8787,
        "hint": "本机监听端口，改完要重启该 shim。"
      },
      "token": {
        "description": "占位 Token",
        "type": "string",
        "default": "sk-workbuddy-local",
        "hint": "插件与 shim 之间的口令，两端自动同步，不用改。",
        "obvious_hint": true
      },
      "auto_tune": {
        "description": "自动调节模型顺序",
        "type": "bool",
        "default": true,
        "hint": "按健康分自动调整顺序：成功加分，失败/超时扣分。",
        "obvious_hint": true
      },
      "cost_hint": {
        "description": "──────  成本说明  ──────",
        "type": "string",
        "default": "",
        "_special": "divider",
        "hint": "看插件页「模型名册」，每个模型标了免费/收费和延迟。",
        "obvious_hint": true
      }
    }
  },
