{
  "workbuddy": {
    "description": "WorkBuddy 接入",
    "type": "object",
    "hint": "开箱即用：自动从 WorkBuddy 桌面端读取并解密凭据。需本机安装并登录 WorkBuddy。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "开启后插件启动时自动拉起该 shim"
      },
      "port": {
        "description": "端口",
        "type": "int",
        "default": 8787
      },
      "token": {
        "description": "占位 Token",
        "type": "string",
        "default": "sk-workbuddy-local",
        "hint": "下游连接 shim 时用的 Bearer，不是你的真实账号密钥"
      }
    }
  },
  "trae": {
    "description": "Trae 接入",
    "type": "object",
    "hint": "开箱即用：自动从 Trae 桌面端 storage.json 解密凭据。需本机安装并登录 Trae。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "port": {
        "description": "端口",
        "type": "int",
        "default": 8788
      },
      "token": {
        "description": "占位 Token",
        "type": "string",
        "default": "sk-trae-local"
      }
    }
  },
  "qoder": {
    "description": "Qoder 接入",
    "type": "object",
    "hint": "开箱即用：自动从 Qoder 桌面端 auth.v1.dat 解密凭据。需本机安装并登录 Qoder。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "port": {
        "description": "端口",
        "type": "int",
        "default": 8789
      },
      "token": {
        "description": "占位 Token",
        "type": "string",
        "default": "sk-qoder-local"
      }
    }
  },
  "workbuddy_intl": {
    "description": "WorkBuddy 国际版接入",
    "type": "object",
    "hint": "与国内版共用同一个 shim 脚本，靠 WB_REGION=global 区分。需要国际版客户端已登录。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": false
      },
      "port": {
        "description": "端口",
        "type": "int",
        "default": 8790
      },
      "token": {
        "description": "占位 Token",
        "type": "string",
        "default": "sk-workbuddy-intl"
      }
    }
  },
  "vision": {
    "description": "视觉模型轮换层",
    "type": "object",
    "hint": "vision-shim.mjs：把多个视觉上游轮起来，供 image_to_text / 视频抽帧使用。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": false
      },
      "port": {
        "description": "端口",
        "type": "int",
        "default": 8791
      },
      "token": {
        "description": "占位 Token",
        "type": "string",
        "default": "sk-vision-local"
      }
    }
  },
  "llm_pool": {
    "description": "通用 LLM 池",
    "type": "object",
    "hint": "llm-pool-shim.mjs：把多个文本上游轮起来，供插件内部固定单 provider 的场景使用（self_learning / qzone / 决策AI）。全部 429 时才有意义。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": false
      },
      "port": {
        "description": "端口",
        "type": "int",
        "default": 8792
      },
      "token": {
        "description": "占位 Token",
        "type": "string",
        "default": "sk-llm-pool-local"
      }
    }
  },
  "advanced": {
    "description": "高级设置",
    "type": "object",
    "items": {
      "node_path": {
        "description": "Node.js 路径",
        "type": "string",
        "default": "",
        "hint": "留空则自动从 PATH 查找"
      },
      "auto_register": {
        "description": "自动注册 Provider",
        "type": "bool",
        "default": true,
        "hint": "shim 起来后自动把模型加进 AstrBot，无需手动配 provider_source"
      }
    }
  }
}
