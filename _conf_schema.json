  "vision": {
    "description": "视觉轮换层",
    "type": "object",
    "hint": "给视觉任务用的轮换层：多个上游轮流用，一个挂了不影响整体。\n\n**默认按优先级 + 自动调节**：排在前面的先用；长期超时的会自动沉到后面，\n好的浮上来。分数存盘，重启不丢。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": false,
        "hint": "本 shim 开关。最终启用 = 总闸 AND 这一项。",
        "obvious_hint": true
      },
      "models": {
        "description": "要注册的模型",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [
          "vision-auto"
        ],
        "hint": "要注册给 AstrBot 的模型名。"
      },
      "port": {
        "description": "端口",
        "type": "int",
        "default": 8791,
        "hint": "本机监听端口，改完要重启该 shim。"
      },
      "token": {
        "description": "占位 Token",
        "type": "string",
        "default": "sk-vision-local",
        "hint": "插件与 shim 之间的口令，两端自动同步，不用改。",
        "obvious_hint": true
      },
      "strategy": {
        "description": "轮换策略",
        "type": "string",
        "default": "priority",
        "options": [
          {
            "label": "按优先级（靠前的先用）",
            "value": "priority"
          },
          {
            "label": "轮换均摊",
            "value": "roundrobin"
          }
        ],
        "hint": "priority = 按优先级；roundrobin = 轮换均摊。",
        "obvious_hint": true
      },
      "priority": {
        "description": "优先级列表",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [],
        "hint": "靠前的先用。留空用内置默认顺序。",
        "obvious_hint": true
      },
      "fail_threshold": {
        "description": "降级阈值",
        "type": "int",
        "default": 2,
        "hint": "连续失败几次降到最后。默认 2。",
        "obvious_hint": true
      },
      "auto_tune": {
        "description": "自动调节",
        "type": "bool",
        "default": true,
        "hint": "按健康分自动调整顺序：成功加分，失败/超时扣分。",
        "obvious_hint": true
      },
      "timeout_penalty": {
        "description": "超时扣分",
        "type": "int",
        "default": 25,
        "hint": "超时一次扣多少分。默认 25。",
        "obvious_hint": true
      },
      "fail_penalty": {
        "description": "失败扣分",
        "type": "int",
        "default": 12,
        "hint": "普通失败一次扣多少分。默认 12。",
        "obvious_hint": true
      },
      "recover_step": {
        "description": "成功加分",
        "type": "int",
        "default": 5,
        "hint": "成功一次加多少分。默认 5。",
        "obvious_hint": true
      },
      "initial_score": {
        "description": "初始分数",
        "type": "int",
        "default": 70,
        "hint": "新目标起始分。默认 70。",
        "obvious_hint": true
      },
      "cost_hint": {
        "description": "──────  轮换层说明  ──────",
        "type": "string",
        "default": "",
        "_special": "divider",
        "hint": "免费/收费模型清单见插件页「模型名册」，或看 SKILL.md。",
        "obvious_hint": true
      }
    }
  },
