  "advanced": {
    "description": "高级设置",
    "type": "object",
    "items": {
      "dependency_hint": {
        "description": "⚠️ 前置依赖：需要 Node.js 18+",
        "type": "string",
        "default": "",
        "_special": "divider",
        "hint": "本插件的 5 个 shim 都是 Node 脚本，**没装 Node.js 就完全不能用**。\n\n装法：去 https://nodejs.org/ 下 LTS 版本 → 装完重启 AstrBot → 命令行 node -v 能出版本号即可。\n\nNode 装在非标准位置的话，到「高级设置 → Node.js 路径」填 node.exe 绝对路径。"
      },
      "node_path": {
        "description": "Node.js 路径",
        "type": "string",
        "default": "",
        "hint": "留空自动查找。填了就用这个路径。"
      },
      "auto_register": {
        "description": "自动注册 Provider",
        "type": "bool",
        "default": true,
        "hint": "启动 shim 后自动把模型注册成 provider。"
      },
      "strict_models": {
        "description": "严格模式：只注册配置里的模型",
        "type": "bool",
        "default": true,
        "hint": "只注册配置里勾选的模型，忽略名册其余项。"
      }
    }
  }
}